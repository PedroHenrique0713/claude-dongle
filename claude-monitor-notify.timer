[Unit]
Description=Checa os limites do Claude Code periodicamente (independe do dongle)

[Timer]
# Dispara mesmo com o dongle morto (idle-kill) ou sem terminal aberto, para o
# aviso de estouro não depender de estar trabalhando na hora.
OnBootSec=2min
OnUnitActiveSec=10min
Persistent=true

[Install]
WantedBy=timers.target
